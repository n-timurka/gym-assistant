{
  "name": "gym-assistant",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-my-app",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 5173 --strictPort",
    "test:e2e": "cypress run --e2e",
    "test:e2e:open": "cypress open",
    "test:e2e:ci": "firebase emulators:exec --only auth,firestore,storage --project demo-my-app \"start-server-and-test dev:e2e http://127.0.0.1:5173 'cypress run --e2e --browser chrome'\"",
    "test:component": "cypress run --component",
    "test:component:open": "cypress open --component",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:component",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "firebase:deploy": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@ionic/vue": "^9.0.10",
    "@ionic/vue-router": "^9.0.10",
    "firebase": "^13.1.0",
    "ionicons": "^8.1.0",
    "start-server-and-test": "^3.0.13",
    "swiper": "^14.3.0",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "cypress": "^16.2.1",
    "cypress-firebase": "^4.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.0.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^22.1.0",
    "terser": "^5.49.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.12",
    "wait-on": "^9.5.1"
  },
  "description": "An Ionic project"
}
